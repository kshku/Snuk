type SomeType {
    var x: int

    fn something() {
        x = 5
    }
}

type SomeType a = {}
a.something()
print a.x

type SomeType b = {}
print b.x
b.something()
print b.x

print if SomeType.x != null {
    "error: Modified the TYPE!!"
} else {
    "Things are working fine"
}

type OneMore {
    var x: SomeType = type SomeType{x: 10}

    fn update() {
        x.x = 30
    }
}

type OneMore oa = {}
type OneMore ob = {}

ob.update()
print OneMore
print oa
print ob

print if oa.x.x == 30 {
    "error: Things aren't working"
} else {
    "Works"
}

oa.x.x = 20
print OneMore
print oa
print ob

print if ob.x.x == 20 {
    "error: Oh shit, we need to copy..."
} else {
    "It is working"
}
